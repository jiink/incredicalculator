{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build incredicalculator_rp (release)",
            "type": "shell",
            "command": "cargo build --release --manifest-path incredicalculator_rp/Cargo.toml --target thumbv8m.main-none-eabihf",
            "options": {
